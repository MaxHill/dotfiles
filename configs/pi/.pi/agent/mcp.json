{
  "mcp": {
    "startup": "eager",
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-local-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--executable-path",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
