{
  "mcpServers": {
    "chrome": {
      "command": "npx",
      "args": ["-y", "chrome-local-mcp"],
      "timeout": 30,
      "description": "Control a local Chrome browser"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--executable-path",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      ],
      "timeout": 30,
      "description": "Automate and inspect web pages with Playwright"
    },
    "jira": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "/Users/8717/.pi/agent/mcp-atlassian.env",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "timeout": 30,
      "description": "Search and read Jira issues, boards, and sprints"
    },
    "figma": {
      "command": "/Users/8717/.pi/agent/bin/figma-mcp",
      "timeout": 30,
      "description": "Read Figma designs and download assets"
    }
  }
}
